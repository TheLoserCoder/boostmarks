{
  "name": "boostmarks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:firefox:lint": "npm run build:firefox && web-ext lint --source-dir .output/firefox-mv3",
    "check": "npm run typecheck && npm run test && npm run build && npm run build:firefox"
  },
  "dependencies": {
    "@wxt-dev/module-react": "^1.2.2",
    "dexie": "^4.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "wxt": "^0.21.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "fake-indexeddb": "^6.2.0",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.2",
    "web-ext": "^10.7.0"
  }
}

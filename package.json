{
  "name": "boostmarks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "eslint . && node scripts/check-file-length.mjs",
    "test": "vitest run && node --test tests/tooling/file-length.test.mjs",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:firefox:lint": "npm run build:firefox && web-ext lint --source-dir .output/firefox-mv3",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run build:firefox"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-virtual": "^3.14.13",
    "@wxt-dev/module-react": "^1.2.2",
    "dexie": "^4.2.1",
    "lucide-react": "^1.48.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "wxt": "^0.21.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.0",
    "globals": "^17.12.0",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2",
    "web-ext": "^10.7.0"
  }
}
